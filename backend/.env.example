DATABASE_URL=postgresql://postgres:postgres@localhost:5432/champ_dev
PORT=3000
NODE_ENV=development

# Comma-separated browser origins (required for prod Docker / Render when frontend has its own host)
# CORS_ORIGINS=https://your-frontend.onrender.com

JWT_ACCESS_SECRET=change-me-min-32-chars-xxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-xxxxxxxxxxxx

# Required for Google/Apple OAuth (Passport state); random long string, distinct from JWT secrets in prod
SESSION_SECRET=change-me-min-32-chars-oauth-session

# Optional Stripe (checkout + POST /stripe/webhook)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_APP_URL=http://localhost:4200

# Optional email provider config
EMAIL_PROVIDER=
RESEND_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:dev@champ.local
